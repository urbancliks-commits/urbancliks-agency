generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth tables ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(INTERN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  internProfile InternProfile?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ── Existing agency domain models ─────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccounts SocialAccount[]
  contentItems   ContentItem[]

  @@map("clients")
}

model SocialAccount {
  id        String   @id @default(cuid())
  clientId  String
  platform  Platform
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("social_accounts")
}

model ContentItem {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  body        String?
  mediaUrls   String[]
  platform    Platform
  status      ContentStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("content_items")
}

// ── Intern management models ──────────────────────────────────────────────────

model InternProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  role         String       // e.g. "Content Creator", "Social Media Coordinator"
  startDate    DateTime     @default(now())
  status       InternStatus @default(ACTIVE)
  bio          String?
  portfolioUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       InternTask[]
  submissions Submission[]

  @@map("intern_profiles")
}

model InternTask {
  id           String     @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus @default(TODO)
  assignedToId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedTo  InternProfile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@map("intern_tasks")
}

model Submission {
  id            String           @id @default(cuid())
  taskId        String
  internId      String
  workUrl       String
  notes         String?
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  task          InternTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  intern        InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
  feedbackItems Feedback[]

  @@map("submissions")
}

model Feedback {
  id           String     @id @default(cuid())
  submissionId String
  authorId     String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Application {
  id           String            @id @default(cuid())
  name         String
  email        String
  roleInterest String
  portfolioUrl String?
  coverNote    String
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("applications")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  INTERN
}

enum InternStatus {
  ACTIVE
  ALUMNI
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REVISION_NEEDED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum Platform {
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
  FACEBOOK
  YOUTUBE
  SNAPCHAT
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}
